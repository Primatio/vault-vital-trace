# Copy this file to .env and fill in values for your setup.
# .env is gitignored and never committed.

# NOTE: localhost refers to the device itself, not your dev machine, so a
# real phone must target your computer's LAN IP. Update this if your
# machine's IP changes (e.g. after reconnecting to Wi-Fi).
SESSION_UPLOAD_URL=http://192.168.1.21:8080/sessions/uploads

# Must match API_KEY in the vault-vital-trace-api .env, sent in the header
# named by API_KEY_HEADER (defaults to x-api-key).
SESSION_UPLOAD_API_KEY=local-dev-test-key-0123456789
