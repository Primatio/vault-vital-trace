# --- Runtime ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=log

# --- Auth (shared secret) ---
# Generate: openssl rand -hex 32
API_KEY=replace-me-with-a-long-random-string
API_KEY_HEADER=x-api-key

# --- Google Cloud Storage ---
GCS_PROJECT_ID=my-gcp-project
GCS_BUCKET_NAME=vital-trace-uploads
GCS_OBJECT_PREFIX=sessions
GCS_ALLOW_OVERWRITE=false
GCS_UPLOAD_TIMEOUT_MS=600000
# Credentials — pick EXACTLY ONE (or neither, to use Application Default
# Credentials on GCP, e.g. Cloud Run/GCE):
#  (a) full service-account JSON on one line
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}
#  (b) path to a keyfile
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa.json

# --- Upload limits (MB) ---
MAX_VIDEO_SIZE_MB=1024
MAX_JSON_SIZE_MB=16
MAX_CSV_SIZE_MB=32

# --- Docs ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
